#!/usr/bin/env bash
set -euo pipefail

# Usage:
# bash coverage_heatmap.sh <snct_dir> <chip_bam_dir> <gene_bed> <output_dir> [threads]
#
# Requires deepTools commands in PATH.
# snct_dir contains C4_snCT_<sample>/output/alignment.fragments.sorted.bam.
# chip_bam_dir contains SRR<accession>.unique.bam.

SNCT_DIR="${1:?Please specify the snCT directory}"
CHIP_BAM_DIR="${2:?Please specify the ChIP BAM directory}"
GENE_BED="${3:?Please specify the gene BED file}"
OUTPUT_DIR="${4:?Please specify the output directory}"
THREADS="${5:-52}"

mkdir -p "$OUTPUT_DIR/bw"

bw_files=()
labels=()

# Generate normalized bigWig files.
while read -r source sample label; do
    case "$source" in
        snCT)
            bam="$SNCT_DIR/$sample/output/alignment.fragments.sorted.bam"
            ;;
        ChIP)
            bam="$CHIP_BAM_DIR/${sample}.unique.bam"
            ;;
    esac

    bw="$OUTPUT_DIR/bw/${label}.bw"

    bamCoverage \
        -b "$bam" \
        -o "$bw" \
        --normalizeUsing CPM \
        --binSize 50 \
        --extendReads \
        --effectiveGenomeSize 373245519 \
        -p "$THREADS"

    bw_files+=("$bw")
    labels+=("$label")
done <<'SAMPLES'
snCT C4_snCT_5 H3K4me3_Nano_Tn5_rep1
snCT C4_snCT_6 H3K4me3_Nano_Tn5_rep2
snCT C4_snCT_7 H3K4me3_Nano_Tn5_Beads_rep1
snCT C4_snCT_8 H3K4me3_Nano_Tn5_Beads_rep2
ChIP SRR10751611 H3K4me3_yl_rep1
ChIP SRR10751612 H3K4me3_yl_rep2
ChIP SRR10751645 H3K4me3_ml_rep1
ChIP SRR10751646 H3K4me3_ml_rep2
SAMPLES

# Summarize signal across genomic bins.
multiBigwigSummary bins \
    --bwfiles "${bw_files[@]}" \
    --numberOfProcessors "$THREADS" \
    --labels "${labels[@]}" \
    -out "$OUTPUT_DIR/H3K4me3_readCounts.npz" \
    --outRawCounts "$OUTPUT_DIR/H3K4me3_readCounts.tab"

# Calculate signal within 10 kb upstream and downstream of TSS.
computeMatrix reference-point \
    -S "${bw_files[@]}" \
    -R "$GENE_BED" \
    --referencePoint TSS \
    --beforeRegionStartLength 10000 \
    --afterRegionStartLength 10000 \
    --sortRegions keep \
    -p "$THREADS" \
    --skipZeros \
    -o "$OUTPUT_DIR/10k_matrix.mat.gz"

# Plot the heatmap.
plotHeatmap \
    -m "$OUTPUT_DIR/10k_matrix.mat.gz" \
    -out "$OUTPUT_DIR/10kH3K4me3_Heatmap.pdf" \
    --samplesLabel \
        snCT_Nano_Tn5_rep1 \
        snCT_Nano_Tn5_rep2 \
        snCT_Nano_Tn5_Beads_rep1 \
        snCT_Nano_Tn5_Beads_rep2 \
        Bulk_yl_rep1 \
        Bulk_yl_rep2 \
        Bulk_ml_rep1 \
        Bulk_ml_rep2 \
    --dpi 1200
